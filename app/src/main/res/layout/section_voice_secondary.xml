<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/settings_voice_secondary_intro"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_engine_secondary_label"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/spinnerEngineSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/settings_engine_secondary_label" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_voice_secondary_label"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/spinnerVoiceSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/settings_voice_secondary_label" />

    <Button
        android:id="@+id/buttonPreviewSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_preview_button" />

</LinearLayout>
