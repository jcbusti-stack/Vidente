<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/settings_gestures_intro"
        android:textSize="14sp" />

    <!-- Las filas (una etiqueta + un Spinner por acción) las arma
         SettingsSectionActivity a partir de GestureConfig.ACTIONS, para que
         la pantalla no pueda quedar desincronizada de la lista real de
         acciones. -->
    <LinearLayout
        android:id="@+id/containerGestures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/buttonResetGestures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/settings_gestures_reset" />

</LinearLayout>
