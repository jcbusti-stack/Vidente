<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityHeading="true"
            android:text="@string/wizard_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/wizard_intro"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonStepBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/wizard_step_battery_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonStepMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/wizard_step_mic_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonStepAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textStepAutostartHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/wizard_step_autostart_hint"
            android:textSize="13sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/checkStepAutostartConfirmed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/wizard_step_autostart_confirm"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonStepAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/wizard_step_accessibility_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonOpenAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_open_app_settings" />

    </LinearLayout>
</ScrollView>
