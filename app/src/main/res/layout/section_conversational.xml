<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_backend_url_label"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editBackendUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/settings_backend_url_label"
        android:hint="@string/settings_backend_url_hint"
        android:inputType="textUri"
        android:maxLines="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_backend_key_label"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editBackendAccessKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/settings_backend_key_label"
        android:hint="@string/settings_backend_key_hint"
        android:inputType="textNoSuggestions"
        android:maxLines="1" />

    <Button
        android:id="@+id/buttonSaveBackendConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/settings_backend_save" />

    <Button
        android:id="@+id/buttonRequestMic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_mic_button" />

</LinearLayout>
